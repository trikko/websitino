	"name": "websitino",
	"description": "File serving, simplified.",
	"dependencies": {
		"serverino": "~>0.7.21"
	},
	"configurations": [
		{
			"targetType": "executable",
			"name": "default"
		},
		{
			"targetType": "executable",
			"dflags": [
				"-static",
				"-nodefaultlib"
			],
			"name": "linux-static"
		},
		{
			"targetType": "executable",
			"dflags": [
				"-link-defaultlib-shared=false",
				"-static"
			],
			"name": "windows-static"
		},
		{
			"targetType": "executable",
			"dflags": [
				"-link-defaultlib-shared=false"
			],
			"name": "macos-static"
		}
	]
}